diff --git a/core/cfg/cl.cpp b/core/cfg/cl.cpp
index 69090df..2ff9146 100644
--- a/core/cfg/cl.cpp
+++ b/core/cfg/cl.cpp
@@ -16,6 +16,7 @@
     You should have received a copy of the GNU General Public License
     along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
 */
+#include <filesystem>
 #include "cfg/cfg.h"
 #include "stdclass.h"
 #include <cstdio>
@@ -221,6 +222,32 @@ void parseCommandLine(int argc, const char * const argv[])
 			WARN_LOG(COMMON, "Rest of command line ignored: '%s'...", argv[i + 1]);
 		break;
 	}
+#ifdef SWR_AOT
+	/* Star Wars Racer recomp: no image on the command line -> look next to the program (and in a
+	   "dreamcast" subfolder) for a .chd / .gdi / .cdi, Star Wars Racer first */
+	if (settings.content.path.empty())
+	{
+		namespace fs = std::filesystem;
+		std::string best;
+		for (const char *sub : { "", "dreamcast" })
+		{
+			std::error_code ec;
+			fs::path dir = fs::u8path(get_writable_config_path(sub));
+			for (const auto& e : fs::directory_iterator(dir, ec))
+			{
+				std::string name = e.path().filename().u8string();
+				std::string ext = get_file_extension(name);
+				if (ext != "chd" && ext != "gdi" && ext != "cdi") continue;
+				std::string low = name; for (auto& ch : low) ch = (char)tolower((unsigned char)ch);
+				bool racer = low.find("racer") != std::string::npos;
+				if (best.empty() || racer) best = e.path().u8string();
+				if (racer) break;
+			}
+			if (!best.empty()) break;
+		}
+		if (!best.empty()) { INFO_LOG(COMMON, "Using '%s' (found next to the program)", best.c_str()); settings.content.path = best; }
+	}
+#endif
 }
 
 }	// namespace config
